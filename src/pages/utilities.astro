---
import utilities from "../collections/utilities.json";
import PageHeading from "../components/page-heading.astro";
import Project from "../components/project.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="My Utilities">
  <section class="relative z-20 mx-auto my-12 max-w-2xl px-7 lg:px-0">
    <PageHeading
      title="My Utilities"
      description="Small utilities I've built to scratch my own itches. They run entirely in your browser, so nothing you open ever leaves your machine."
    />

    <div
      class="z-50 my-8 grid w-full grid-cols-1 items-stretch gap-7 sm:grid-cols-2 sm:gap-5"
    >
      {
        utilities.map((utility) => {
          return (
            <Project
              name={utility.name}
              description={utility.description}
              uses={utility.uses}
              image={utility.image}
              url={utility.url}
            />
          );
        })
      }
    </div>
  </section>
</Layout>
