---
import utilities from "../collections/utilities.json";
import Card from "../components/card.astro";
import PageHeading from "../components/page-heading.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="My Utilities">
  <section class="relative z-20 mx-auto my-12 max-w-4xl px-7 lg:px-0">
    <PageHeading
      title="My Utilities"
      description="Apps I've built in my free time. Every one of them is free — open it in your browser or download it and go."
    />

    <div
      class="z-50 my-8 grid w-full grid-cols-1 items-stretch gap-7 sm:grid-cols-2 md:grid-cols-3"
    >
      {
        utilities.map((utility) => {
          return (
            <Card
              name={utility.name}
              description={utility.description}
              uses={utility.uses}
              image={utility.image}
              url={utility.url}
            />
          );
        })
      }
    </div>
  </section>
</Layout>
